diff --git a/os/lib/random.c b/os/lib/random.c
index ef96cdac5..b45c6dd92 100644
--- a/os/lib/random.c
+++ b/os/lib/random.c
@@ -58,21 +58,19 @@ random_init(void)
   uint64_t seed;
 #if CSPRNG_ENABLED
   if(csprng_rand((uint8_t *)&seed, sizeof(seed))) {
-    LOG_DBG("Generated seed with CSPRNG: 0x%" PRIx64 "\n", seed);
+    /* LOG_DBG removed: PRIx64 incompatible with gcc 13 */
   } else
