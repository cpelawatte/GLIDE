/*
 * tamarin_model.spthy
 * Tamarin Prover model for L-ECQV + DID Authentication Protocol
 *
 * Protocol: EDHOC subset with ECQV implicit certificates
 * Tool: Tamarin Prover (https://tamarin-prover.github.io)
 * Version: Written for Tamarin 1.6.x+ (tested on 1.12.0)
 *
  * SCOPE (Fix 2 model, GLIDE-Access): gateway-side authentication of the
 * device (with injective agreement and recentness, via the epoch beacon),
 * device-side authentication of the gateway, session-key agreement and
 * secrecy, forward secrecy against long-term key reveal, and key-compromise
 * impersonation (KCI). GLIDE does NOT claim mutual authentication in the
 * explicit-key-confirmation sense (no MSG_3). Denial of service is not
 * modeled: Tamarin proves safety properties, not availability.
 *
 * MODELING DECISIONS:
 * 1. ECQV reconstruction is modeled abstractly: the certificate carries
 *    the device's reconstructed public key Q_dev = pk(~u) directly,
 *    issuer-signed alongside R and cert_info. The gateway trusts Q_dev
 *    because the issuer's signature over <R, Q_dev, cert_info> verifies
 *    against the pinned issuer public key Q_ca. This represents the
 *    guarantee ECQV provides (Q_dev is bound to R and cert_info by the
 *    issuer) without modeling the EC arithmetic (d*G = e*R + Q_ca)
  *    itself, which is outside the scope of this work. ECQV is relied on
 *    through its standard (SEC 4) and its security reduction (Brown,
 *    Gallant and Vanstone, 2001).
 * 2. HKDF is modeled as a random oracle (standard assumption).
 * 3. The Dolev-Yao adversary controls the network between D and G.
 * 4. Provisioning (issuer generating the certificate) is modeled as
 *    a trusted setup phase outside the adversary's reach.
 *
 * NAMING CONVENTION (avoids sort/capitalization warnings):
 *   ~xd   = device long-term private key (scalar) — unifies with ~u
 *           from provisioning via the !DevicePrivateKey fact
 *   ~xed  = device ephemeral private exponent
 *   E_d   = device ephemeral public group element ('g'^~xed)
 *   ~e_g  = gateway ephemeral private exponent
 *   E_g   = gateway ephemeral public group element ('g'^~e_g)
 *   Q_dev = device long-term public key, pk(~xd) == pk(~u)
 *
 * cert_sig and ci are plain (message-sort) variables in Device_Send_MSG1,
 * not fresh (~), because they bind to compound terms from the cert:
 * cert_sig -> sign(...), ci -> cert_info(...). A ~-variable can only
 * match a fresh nonce, so these must be unprefixed.
 *
 * FIX (this revision): the Eq(...) equality checks were previously placed
 * in the rule PREMISES (left of --[ ), where they were treated as linear
 * facts requiring a producer. No rule produces an Eq fact, so the rules
 * Gateway_Recv_MSG1_Send_MSG2 and Device_Recv_MSG2 could never fire,
 * making every downstream lemma vacuously true. Eq is a restriction
 * action fact and MUST appear inside --[ ]-> so that
 * `restriction Equality` can discharge it. All three Eq facts have been
 * moved to the action position accordingly.
 */

theory LECQV_DID_Auth
begin

builtins: signing, diffie-hellman, hashing

/*
 * ── Function Declarations ───────────────────────────────────────────
 */

/* HKDF key derivation: modeled as a hash over transcript + shared secret */
functions: hkdf/2

/* Certificate info structure */
functions: cert_info/3  /* opaque; real encoding (Fix 7): issuer_id(4 B) | issued_at(uint32) | max_age(uint16, hours) */

/*
 * ── Public Key Infrastructure ───────────────────────────────────────
 * Models the provisioning phase as a trusted setup.
 */

/* Issuer generates its keypair */
rule Issuer_Setup:
    [ Fr(~d_ca) ]
  --[ IssuerSetup($I, pk(~d_ca)) ]->
    [ !IssuerKey($I, ~d_ca)
    , !IssuerPubKey($I, pk(~d_ca))
    , Out(pk(~d_ca))   /* Q_ca is public */
    ]

/* Issuer provisions a device: generates R, cert_info, and binds the
 * device's reconstructed public key Q_dev = pk(~u) into the certificate
 * signature. This represents the ECQV guarantee: Q_dev is certified as
 * bound to R and cert_info by the issuer, without modeling the EC
 * reconstruction arithmetic itself (see Modeling Decision 1). */
rule Issuer_Provision_Device:
    [ !IssuerKey($I, ~d_ca)
    , Fr(~k)           /* issuer's per-cert randomness */
    , Fr(~u)           /* device's long-term private key */
    ]
  --[ ProvisionedDevice($I, $D, pk(~u))
    , DevicePrivKey($D, ~u)  /* track for secrecy lemma */
    ]->
    [ /* R = k*G + u*G (simplified; real: k*G + U where U = u*G) */
      !DeviceCert($D,
                  ~k,            /* R stored as k (abstract) */
                  sign(<~k, pk(~u), cert_info($I, 'timestamp', '31536000')>, ~d_ca),
                  pk(~u),        /* Q_dev, issuer-attested */
                  cert_info($I, 'timestamp', '31536000'))
    , !DevicePrivateKey($D, ~u)
    , !DevicePubKey($D, pk(~u))
    ]

/* Gateway bootstraps with pinned issuer public key */
rule Gateway_Bootstrap:
    [ !IssuerPubKey($I, Q_ca)
    , Fr(~gw_key)
    , Fr(~r0)                      /* first epoch's beacon value (Fix 2) */
    ]
  --[ GatewayBootstrap($G, $I, Q_ca)
    , EpochStart($G, ~r0)
    ]->
    [ !GatewayKey($G, ~gw_key)
    , !GatewayPubKey($G, pk(~gw_key))
    , !GatewayPinnedIssuer($G, $I, Q_ca)
    , Out(pk(~gw_key))   /* gateway public key is public */
    , GwEpoch($G, ~gw_key, ~r0)    /* progress through epochs: linear, one at a time, used ONLY by Gateway_New_Epoch */
    , !GwEp($G, ~gw_key, ~r0)      /* an epoch value that exists: persistent, read by the receive rule */
    , Out(~r0)                     /* the beacon value is public once announced */
    ]

/* Fix 2: the bell rings. The gateway ends the current epoch, picks a fresh
 * random value and announces it. The strict rule (decision 5: an ended epoch
 * is never accepted again) is the Epoch_Is_Current restriction below, and the
 * per-epoch nonce sheet is Nonce_Sheet_Once_Per_Epoch: it is keyed by the
 * epoch value, so a new epoch starts with an empty sheet. */
rule Gateway_New_Epoch:
    [ GwEpoch($G, ~gw_key, ~r_old)
    , Fr(~r_new)
    ]
  --[ EpochEnd($G, ~r_old)
    , EpochStart($G, ~r_new)
    ]->
    [ GwEpoch($G, ~gw_key, ~r_new)
    , !GwEp($G, ~gw_key, ~r_new)
    , Out(~r_new)
    ]

/* Device is provisioned with gateway public key */
rule Device_Store_GW_Pubkey:
    [ !GatewayPubKey($G, Q_gw)
    , !DevicePrivateKey($D, ~xd)
    ]
  --[ DeviceKnowsGateway($D, $G) ]->
    [ !DeviceGWKey($D, $G, Q_gw) ]

/*
 * ── Protocol Rules ──────────────────────────────────────────────────
 */

/* Device builds and sends MSG_1.
 * Q_dev = pk(~xd) is carried in-band along with the issuer's
 * certificate signature (cert_sig) so the gateway can verify both
 * the issuer's binding and the device's signature without needing
 * an ecqv_reconstruct function. */
rule Device_Send_MSG1:
    let
        /* Ephemeral public group element */
        E_d     = 'g'^~xed
        /* Device long-term public key, issuer-attested */
        Q_dev   = pk(~xd)
        /* Signing payload: E_d || R || Q_dev || cert_info || nonce_d */
        payload = <E_d, ~R, Q_dev, ci, ~nonce_d, Q_gw, br>
        /* Signature under device long-term key */
        sig_d   = sign(payload, ~xd)
        msg1    = <E_d, ~R, Q_dev, cert_sig, ci, ~nonce_d, sig_d>
    in
    [ !DevicePrivateKey($D, ~xd)
    , !DeviceCert($D, ~R, cert_sig, Q_dev, ci)
    , !DeviceGWKey($D, $G, Q_gw)
    , In(br)                       /* any beacon the network hands the device; it does not check it (decision 2) */
    , Fr(~xed)
    , Fr(~nonce_d)
    ]
  --[ DeviceSentMSG1($D, $G, msg1, ~nonce_d, E_d)
    , DeviceSignedBeacon($D, $G, ~nonce_d, br)
    ]->
    [ DeviceWaitingMSG2($D, $G, ~xd, ~xed, E_d, ~nonce_d, msg1)
    , Out(msg1)
    ]

/* Gateway receives MSG_1 and sends MSG_2.
 *
 * Trust chain: the gateway verifies the issuer's certificate signature
 * over <R, Q_dev, ci> against the pinned issuer key Q_ca. This is the
 * ECQV-equivalent guarantee — Q_dev is certified as bound to R and
 * cert_info. The gateway then verifies the device's signature sig_d
 * against that issuer-attested Q_dev. Both checks resolve via the
 * single builtin equation verify(sign(m,k),m,pk(k)) = true.
 *
 * FIX: both Eq(verify(...)) checks are action facts (inside --[ ]->),
 * discharged by `restriction Equality`, NOT premises. */
rule Gateway_Recv_MSG1_Send_MSG2:
    let
        /* Signing payload for device signature verification */
        payload = <E_d, R, Q_dev, ci, nonce_d, pk(~gw_key), ~ep>
        /* Gateway ephemeral public group element */
        E_g     = 'g'^~e_g
        /* MSG_1 as received */
        msg1    = <E_d, R, Q_dev, cert_sig, ci, nonce_d, sig_d>
        /* Gateway signs transcript */
        sig_g   = sign(<msg1, E_g, ~nonce_g>, ~gw_key)
        msg2    = <E_g, ~nonce_g, sig_g>
        /* Derive session key via ECDH: ss = E_d^~e_g = 'g'^(~xed*~e_g) */
        ss      = E_d^~e_g
        sk      = hkdf(<msg1, msg2>, ss)
    in
    [ !GatewayKey($G, ~gw_key)
    , !GatewayPinnedIssuer($G, $I, Q_ca)
    , !GwEp($G, ~gw_key, ~ep)       /* the gateway's OWN epoch value; nothing from the message is trusted */
    , In(<E_d, R, Q_dev, cert_sig, ci, nonce_d, sig_d>)
    , Fr(~e_g)
    , Fr(~nonce_g)
    ]
  --[ Eq(verify(cert_sig, <R, Q_dev, ci>, Q_ca), true)
    , Eq(verify(sig_d, payload, Q_dev), true)
    , GatewayAuthenticatedDevice($G, Q_dev, sk)
    , GwAccept($G, Q_dev, nonce_d, ~ep)
    , GatewaySentMSG2($G, msg2, ~nonce_g, E_g, sk)
    , SessionKey($G, sk)
    , Secret($G, sk)
    , SecretPFSGw($G, Q_dev, sk)
    , Neq(E_d, E_g)
    ]->
    [ GatewayDone($G, sk)
    , Out(msg2)
    ]

/* Device receives MSG_2 and derives session key
 *
 * Binds the received gateway ephemeral E_g directly as a group
 * element (no 'g'^e_g_exp extraction). Diffie-Hellman does not require
 * the device to know the discrete log of the peer's ephemeral; it only
 * raises the received element to its own secret exponent ~xed.
 *   ss = E_g^~xed = 'g'^(~e_g*~xed)  (equal to gateway's ss by DH)
 *
 * FIX: the Eq(verify(...)) check is an action fact (inside --[ ]->),
 * discharged by `restriction Equality`, NOT a premise. */
rule Device_Recv_MSG2:
    let
        msg2 = <E_g, nonce_g, sig_g>
        ss   = E_g^~xed
        sk   = hkdf(<msg1, msg2>, ss)
    in
    [ DeviceWaitingMSG2($D, $G, ~xd, ~xed, E_d, ~nonce_d, msg1)
    , !DeviceGWKey($D, $G, Q_gw)
    , In(<E_g, nonce_g, sig_g>)
    ]
  --[ Eq(verify(sig_g, <msg1, E_g, nonce_g>, Q_gw), true)
    , DeviceAuthenticatedGateway($D, $G, sk)
    , SessionKey($D, sk)
    , Secret($D, sk)
    , SecretPFS($D, $G, sk)
    , DeviceDone($D, $G, sk)
    ]->
    [ DeviceDone($D, $G, sk) ]


/*
 * ── Forward Secrecy: long-term key reveal (Semester 3) ────────────────
 * Gives the adversary the ability to compromise a long-term key at any
 * point in the trace. Session keys derived before that point must remain
 * secret even after the reveal — that is the actual PFS property.
 */
rule Reveal_Device_LTK:
    [ !DevicePrivateKey($D, ~xd) ]
  --[ RevealDev($D)
    , RevealedKey(pk(~xd)) ]->
    [ Out(~xd) ]

rule Reveal_Gateway_LTK:
    [ !GatewayKey($G, ~gw_key) ]
  --[ RevealGw($G)
    , RevealedKey(pk(~gw_key)) ]->
    [ Out(~gw_key) ]

/*
 * ── Restrictions ────────────────────────────────────────────────────
 */

restriction Equality:
    "All x y #i. Eq(x,y) @i ==> x = y"

restriction Inequality:
    "All x #i. Neq(x,x) @i ==> F"

/* Fix 2, decision 6: the per-epoch nonce sheet. The gateway never accepts the
 * same (device, nonce) twice within one epoch value. Size limit (2 x N) and
 * fail-closed overflow are implementation guarantees measured in Cooja, not
 * proven here: Tamarin state is unbounded. */
/* Fix 2, decision 5 (strict): once an epoch has ended the gateway no longer
 * accepts messages signed for it. */
restriction Epoch_Is_Current:
    "All G Q n r #i #e.
        GwAccept(G, Q, n, r) @i & EpochEnd(G, r) @e ==> #i < #e"

restriction Nonce_Sheet_Once_Per_Epoch:
    "All G Q n r #i #j.
        GwAccept(G, Q, n, r) @i & GwAccept(G, Q, n, r) @j ==> #i = #j"

/*
 * ── Security Lemmas ─────────────────────────────────────────────────
 */

/*
 * Lemma 1: Executability
 * The protocol can complete without the adversary blocking it.
 * This sanity-checks that our model is not trivially unprovable.
 */
lemma Executability:
    exists-trace
    "Ex D G sk #i.
        DeviceAuthenticatedGateway(D, G, sk) @i"

/*
 * Lemma 2: Gateway non-injective agreement on the addressed gateway
 * (cross-gateway relay; maps to none of G1-G6) -- Semester 3: VERIFIED
 * after binding Q_gw into the device signature. Positive witness for
 * the separate same-gateway replay weakness remains in Gateway_Replay_Possible.
 */
lemma Gateway_Authenticates_Device:
    "All G Q_dev sk #i.
        GatewayAuthenticatedDevice(G, Q_dev, sk) @i
      ==>
        (Ex D msg1 nonce_d E_d #j.
            DeviceSentMSG1(D, G, msg1, nonce_d, E_d) @j
          & #j < #i)
        | (Ex #r. RevealedKey(Q_dev) @r & #r < #i)"

/*
 * Lemma 3: Device authentication of Gateway + cross-party key agreement (not a numbered goal; one of the three properties beyond G1-G6)
 */
lemma Device_Authenticates_Gateway:
    "All D G sk #i.
        DeviceAuthenticatedGateway(D, G, sk) @i
      ==>
        (Ex msg2 nonce_g E_g #j.
            GatewaySentMSG2(G, msg2, nonce_g, E_g, sk) @j
          & #j < #i)
        | (Ex #r. RevealGw(G) @r & #r < #i)"

/*
 * Lemma 4: Session Key Agreement
 *
 * If two session keys are recorded at the same instant for the same
 * party, they are identical. (Agreement on the session key.)
 */
lemma Session_Key_Agreement:
    "All G sk1 sk2 #i #j.
        SessionKey(G, sk1) @i
      & SessionKey(G, sk2) @j
      & #i = #j
      ==>
        sk1 = sk2"

/*
 * Lemma 5: Session Key Secrecy
 *
 * A session key recorded as Secret by any party is never learned by
 * the Dolev-Yao adversary.
 */
lemma Session_Key_Secrecy:
    "All A sk #i.
        Secret(A, sk) @i
      ==>
        not (Ex #j. K(sk) @j)
        | (Ex B #r. RevealDev(B) @r & #r < #i)
        | (Ex B #r. RevealGw(B) @r & #r < #i)"
/*
 * Lemma 6: Gateway authentication of Device origin (Goal G1, device authentication)
 * Gateway accepts only credentials the issuer provisioned. VERIFIED.
 */

lemma Gateway_Authenticates_Device_Origin:
    "All G Q_dev sk #i.
        GatewayAuthenticatedDevice(G, Q_dev, sk) @i
      ==>
        (Ex I D #j. ProvisionedDevice(I, D, Q_dev) @j & j < i)"

/*
 * Sanity: the gateway's authentication event is reachable.
 * (Companion to Executability; guards against vacuous all-traces lemmas.)
 */
lemma sanity_gateway_reachable:
    exists-trace
    "Ex G Q_dev sk #i. GatewayAuthenticatedDevice(G, Q_dev, sk) @i"


lemma Gateway_Replay_Possible:
    exists-trace
    "Ex G Q_dev sk1 sk2 #i1 #i2.
         GatewayAuthenticatedDevice(G, Q_dev, sk1) @i1
       & GatewayAuthenticatedDevice(G, Q_dev, sk2) @i2
       & not(#i1 = #i2)
       & (Ex D msg1 nonce_d E_d #j.
             DeviceSentMSG1(D, G, msg1, nonce_d, E_d) @j
           & #j < #i1 & #j < #i2)"

/*
 * Lemma 9/10: Forward Secrecy (Semester 3)
 *
 * A session key recorded as Secret remains unknown to the adversary
 * UNLESS the relevant party's long-term key was revealed before that
 * session key was established. A reveal AFTER the session does not
 * excuse a leak -- that is the actual forward-secrecy property, and it
 * is what distinguishes this from Session_Key_Secrecy above.
 */
lemma Forward_Secrecy_Device:
    all-traces
    "All D G sk #i.
        SecretPFS(D, G, sk) @i
      ==>
        not (Ex #j. K(sk) @j)
        | (Ex #r. RevealDev(D) @r & #r < #i)
        | (Ex #r. RevealGw(G) @r & #r < #i)"

lemma Forward_Secrecy_Gateway:
    all-traces
    "All G Q_dev sk #i.
        SecretPFSGw(G, Q_dev, sk) @i
      ==>
        not (Ex #j. K(sk) @j)
        | (Ex #r. RevealedKey(Q_dev) @r & #r < #i)
        | (Ex #r. RevealGw(G) @r & #r < #i)"


/*
 * Fix 5: Key-compromise impersonation (KCI).
 * Malik et al. claim KCI protection informally; these prove it.
 * Each KCI lemma forces the key theft to happen BEFORE the session
 * completes. Each has a reachability companion so the KCI result
 * cannot be vacuously true.
 */
lemma KCI_Device_Side:
    "All D G sk #i #r.
        DeviceAuthenticatedGateway(D, G, sk) @i
      & RevealDev(D) @r
      & #r < #i
      ==>
        (Ex msg2 nonce_g E_g #j.
            GatewaySentMSG2(G, msg2, nonce_g, E_g, sk) @j
          & #j < #i)
        | (Ex #r2. RevealGw(G) @r2 & #r2 < #i)"

lemma KCI_Gateway_Side:
    "All G Q_dev sk #i #r.
        GatewayAuthenticatedDevice(G, Q_dev, sk) @i
      & RevealGw(G) @r
      & #r < #i
      ==>
        (Ex D msg1 nonce_d E_d #j.
            DeviceSentMSG1(D, G, msg1, nonce_d, E_d) @j
          & #j < #i)
        | (Ex #r2. RevealedKey(Q_dev) @r2 & #r2 < #i)"

lemma KCI_Device_Scenario_Reachable:
    exists-trace
    "Ex D G sk #i #r.
        DeviceAuthenticatedGateway(D, G, sk) @i
      & RevealDev(D) @r
      & #r < #i"

lemma KCI_Gateway_Scenario_Reachable:
    exists-trace
    "Ex G Q_dev sk #i #r.
        GatewayAuthenticatedDevice(G, Q_dev, sk) @i
      & RevealGw(G) @r
      & #r < #i"

/*
 * Strict replay -- the before/after lemma of Fix 2.
 * "No trace exists in which ONE device send (and no other send to this
 * gateway) leads the same gateway to accept the same device twice."
 * Unlike Gateway_Replay_Possible, honest re-authentication (two sends)
 * does NOT satisfy this, so it isolates genuine replay.
 * Key theft is excluded: a stolen key can forge fresh messages, which is
 * not replay.  Before Fix 2 this lemma is FALSIFIED (the counterexample is
 * the replay attack); after Fix 2 it is VERIFIED.
 */
lemma No_Replay:
    "not (Ex G Q sk1 sk2 D msg1 n E #i1 #i2 #j.
            GatewayAuthenticatedDevice(G, Q, sk1) @i1
          & GatewayAuthenticatedDevice(G, Q, sk2) @i2
          & not(#i1 = #i2)
          & DeviceSentMSG1(D, G, msg1, n, E) @j
          & #j < #i1 & #j < #i2
          & (All D2 m2 n2 E2 #k.
                DeviceSentMSG1(D2, G, m2, n2, E2) @k ==> #k = #j)
          & not (Ex #rv. RevealedKey(Q) @rv))"

/* Injective agreement, device -> gateway (Lowe's strongest rung for this direction):
 * every acceptance has a matching send by a device addressed to that gateway,
 * and no second acceptance uses the same nonce -- unless the device key had been
 * revealed before that second acceptance (a thief can forge; that is not replay). */
lemma Gateway_Injective_Agreement:
    "All G Q n r #i.
        GwAccept(G, Q, n, r) @i
      ==>
          (Ex D msg1 E #j.
              DeviceSentMSG1(D, G, msg1, n, E) @j & #j < #i
            & not (Ex G2 Q2 r2 #i2.
                     GwAccept(G2, Q2, n, r2) @i2 & not(#i2 = #i)
                   & not (Ex #rv2. RevealedKey(Q2) @rv2 & #rv2 < #i2)))
        | (Ex #rv. RevealedKey(Q) @rv & #rv < #i)"

/* Recentness / no pre-play: the device signed the gateway's real epoch value
 * only AFTER that epoch began, and the message was accepted while that epoch
 * was still current. "Created and delivered within one epoch." */
lemma Gateway_Recentness:
    "All G Q n r #i.
        GwAccept(G, Q, n, r) @i
      ==>
          (Ex D #j #s. DeviceSignedBeacon(D, G, n, r) @j
                     & EpochStart(G, r) @s
                     & #s < #j & #j < #i
                     & not (Ex #e. EpochEnd(G, r) @e & #e < #i))
        | (Ex #rv. RevealedKey(Q) @rv & #rv < #i)"

/* A fake beacon never leads to acceptance: if a device signed a value that is
 * no gateway's real epoch value, then no gateway accepts a message carrying that
 * device's nonce -- unless the accepted key had been revealed first (a thief
 * signing with a stolen key is forgery, not a beacon attack). */
lemma Fake_Beacon_Never_Accepted:
    "All D G n br #j G3 Q r #i.
        DeviceSignedBeacon(D, G, n, br) @j
      & GwAccept(G3, Q, n, r) @i
      ==>
          (Ex G2 #s. EpochStart(G2, br) @s)
        | (Ex #rv. RevealedKey(Q) @rv & #rv < #i)"

/* Non-vacuity guards for the new rule and restriction. */
lemma Second_Epoch_Accept_Reachable:
    exists-trace
    "Ex G r0 r1 Q n #a #b #i.
        EpochStart(G, r0) @a & EpochEnd(G, r0) @b & EpochStart(G, r1) @b
      & #a < #b
      & GwAccept(G, Q, n, r1) @i & #b < #i"

lemma Two_Accepts_Same_Epoch_Reachable:
    exists-trace
    "Ex G Q1 Q2 n1 n2 r #i1 #i2.
        GwAccept(G, Q1, n1, r) @i1 & GwAccept(G, Q2, n2, r) @i2
      & not(#i1 = #i2)"

end
